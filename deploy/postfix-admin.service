[Unit]
Description=Postfix Admin Web Interface
After=network.target postfix.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/postfix-admin
Environment="SECRET_KEY=replace-with-random-secret"
Environment="USERS_FILE=/opt/postfix-admin/users.json"
ExecStart=/usr/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target